<mxfile host="app.diagrams.net">
  <diagram name="Detailed Sequence Diagram">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Lifelines -->
        <!-- 1. User -->
        <mxCell id="act_user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="line_user" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="act_user">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="65" y="130" as="sourcePoint" /><mxPoint x="65" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 2. UI (index.html) -->
        <mxCell id="box_ui" value="UI (index.html)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="70" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_ui" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_ui">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="205" y="120" as="sourcePoint" /><mxPoint x="205" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 3. Parser (fileParser.js) -->
        <mxCell id="box_parser" value="FileParser&#10;(fileParser.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_parser" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_parser">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="355" y="120" as="sourcePoint" /><mxPoint x="355" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 4. Controller (app.js) -->
        <mxCell id="box_ctrl" value="App Controller&#10;(app.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="70" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_ctrl" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_ctrl">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="515" y="120" as="sourcePoint" /><mxPoint x="515" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 5. Perplexity (perplexity.js) -->
        <mxCell id="box_perp" value="PerplexityAnalyzer&#10;(perplexity.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_perp" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_perp">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="685" y="120" as="sourcePoint" /><mxPoint x="685" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 6. FeatureExtractor (knn.js) -->
        <mxCell id="box_feat" value="FeatureExtractor&#10;(knn.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="70" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_feat" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_feat">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="855" y="120" as="sourcePoint" /><mxPoint x="855" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 7. Classifiers (6 Engines) -->
        <mxCell id="box_algo" value="Ensemble Classifiers&#10;(KNN, LR, Trigram, POS, Sim, Grammar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="70" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_algo" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_algo">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1070" y="120" as="sourcePoint" /><mxPoint x="1070" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 8. ChartRenderer (chartRenderer.js) -->
        <mxCell id="box_chart" value="ChartRenderer&#10;(chartRenderer.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="70" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_chart" value="" style="html=1;points=[];dashed=1;strokeWidth=1;" edge="1" parent="1" source="box_chart">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1285" y="120" as="sourcePoint" /><mxPoint x="1285" y="750" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Message Calls -->
        <!-- 1. Drop file / Type -->
        <mxCell id="m1" value="1. Drop file (.txt/.docx) or Type text" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="65" y="150" as="sourcePoint" /><mxPoint x="205" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 2. extractText -->
        <mxCell id="m2" value="2. extractText(file)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="205" y="190" as="sourcePoint" /><mxPoint x="355" y="190" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 3. Return raw text -->
        <mxCell id="m3" value="3. Return extractedText" style="html=1;verticalAlign=bottom;endArrow=dashed;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="230" as="sourcePoint" /><mxPoint x="205" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 4. Click Analyze -->
        <mxCell id="m4" value="4. executeAnalysisCore(text)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="205" y="270" as="sourcePoint" /><mxPoint x="515" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 5. Perplexity analyze -->
        <mxCell id="m5" value="5. analyze(text)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="310" as="sourcePoint" /><mxPoint x="685" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 6. Return stats -->
        <mxCell id="m6" value="6. Return { wordCount, sentenceCount, burstiness, ttr }" style="html=1;verticalAlign=bottom;endArrow=dashed;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="685" y="350" as="sourcePoint" /><mxPoint x="515" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 7. extractFeatures -->
        <mxCell id="m7" value="7. extractFeatures(text, perplexityResult)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="390" as="sourcePoint" /><mxPoint x="855" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 8. Return vector -->
        <mxCell id="m8" value="8. Return featureVector" style="html=1;verticalAlign=bottom;endArrow=dashed;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="855" y="430" as="sourcePoint" /><mxPoint x="515" y="430" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 9. Parallel Classifiers -->
        <mxCell id="m9" value="9. Run LR, KNN, Trigrams, POS, Similarity, Grammar" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="470" as="sourcePoint" /><mxPoint x="1070" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 10. Return scores -->
        <mxCell id="m10" value="10. Return individual scores &amp; perfectionScore" style="html=1;verticalAlign=bottom;endArrow=dashed;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="510" as="sourcePoint" /><mxPoint x="515" y="510" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 11. Self Call: Compute Weighted Score -->
        <mxCell id="m11" value="11. Calculate weightedScore &amp; Apply Grammar Boost -> finalPercentage" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="550" as="sourcePoint" />
            <mxPoint x="515" y="590" as="targetPoint" />
            <Array as="points"><mxPoint x="555" y="550" /><mxPoint x="555" y="590" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 12. renderGauge -->
        <mxCell id="m12" value="12. renderGauge(finalPercentage)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="630" as="sourcePoint" /><mxPoint x="1285" y="630" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 13. Update UI -->
        <mxCell id="m13" value="13. Update Verdict Banner &amp; Metric Stats Cards" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="515" y="670" as="sourcePoint" /><mxPoint x="205" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- 14. Display Dashboard -->
        <mxCell id="m14" value="14. Display AI Detection Dashboard &amp; Highlight Sentences" style="html=1;verticalAlign=bottom;endArrow=dashed;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="205" y="710" as="sourcePoint" /><mxPoint x="65" y="710" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>