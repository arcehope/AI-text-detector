<mxfile host="app.diagrams.net">
  <diagram name="State Diagram - AI Text Detector">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="30" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="st_init" value="1. INITIALIZATION&#10;Instantiate 9 Engines:&#10;Perplexity, KNN, LR, Trigram,&#10;POS, Similarity, Grammar, FileParser, Chart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="205" width="220" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="st_idle" value="2. IDLE &amp; DEBOUNCE&#10;Awaiting Input / File Drop&#10;(1s Typing Debounce Delay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="205" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="st_file" value="3. FILE PARSING&#10;FileParser.extractText(file)&#10;(Extract TXT / DOCX text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="340" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_val" value="4. WORD COUNT CHECK&#10;result1.wordCount &gt;= 10?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="205" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="st_nlp" value="5. ENSEMBLE CLASSIFICATION&#10;LR (25%) + KNN (20%) + Trigram (25%)&#10;+ POS (15%) + Sim (10%) + Perplexity (5%)&#10;* Grammar Factor + Perfect Boost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="205" width="230" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="st_render" value="6. DASHBOARD RENDERING&#10;Verdict Banner (&gt;60% AI / &gt;35% Mixed)&#10;Render SVG Gauge &amp; Metrics Cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="340" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="c1" value="DOMContentLoaded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="st_init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Engines Ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_init" target="st_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="File Drop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_idle" target="st_file">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Text Extracted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_file" target="st_val">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Analyze Click / Pause" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_idle" target="st_val">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="words &gt;= 10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_val" target="st_nlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="words &lt; 10 (Abort)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_val" target="st_idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="680" y="150" /><mxPoint x="460" y="150" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c8" value="Final Score Calculated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_nlp" target="st_render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Clear / New Input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_render" target="st_idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="925" y="450" /><mxPoint x="460" y="450" /></Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
