<mxfile host="app.diagrams.net">
  <diagram name="AI Text Detector Object &amp; Schema Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1170">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="hdr" value="AI Text Detector — Object &amp; Class Diagram (Draw.io Native)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1180" height="40" as="geometry" />
        </mxCell>

        <!-- Entity 1: Parses -->
        <mxCell id="obj_parses" value="&lt;b&gt;Parses&lt;/b&gt;&lt;hr/&gt;documentId: string pk&lt;br/&gt;filePath: string&lt;br/&gt;rawContent: string&lt;br/&gt;wordCount: number&lt;br/&gt;parsedAt: timestamp" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="320" height="195" as="geometry" />
        </mxCell>

        <!-- Entity 2: Sentence Perplexity -->
        <mxCell id="obj_perp" value="&lt;b&gt;Sentence Perplexity&lt;/b&gt;&lt;hr/&gt;id: string pk&lt;br/&gt;documentId: string fk&lt;br/&gt;perplexityScore: number&lt;br/&gt;burstiness: number&lt;br/&gt;sentenceLength: array&lt;br/&gt;uniformityIndex: number" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="340" height="225" as="geometry" />
        </mxCell>

        <!-- Entity 3: Vector Similarities -->
        <mxCell id="obj_vec" value="&lt;b&gt;Vector Similarities&lt;/b&gt;&lt;hr/&gt;id: string pk&lt;br/&gt;documentId: string fk&lt;br/&gt;vectorEmbedding: array&lt;br/&gt;aiSimilarity: number&lt;br/&gt;humanSimilarity: number&lt;br/&gt;cosineDistance: number" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="850" y="350" width="340" height="225" as="geometry" />
