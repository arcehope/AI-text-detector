        <!-- Entity 4: Instance Based Classification -->
        <mxCell id="obj_class" value="&lt;b&gt;Instance Based Classification&lt;/b&gt;&lt;hr/&gt;id: string pk&lt;br/&gt;perplexityId: string fk&lt;br/&gt;similarityId: string fk&lt;br/&gt;kNeighbors: number&lt;br/&gt;predictedClass: string&lt;br/&gt;confidenceScore: number" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="380" height="225" as="geometry" />
        </mxCell>

        <!-- Entity 5: Render SVG visualization -->
        <mxCell id="obj_svg" value="&lt;b&gt;Render SVG visualization&lt;/b&gt;&lt;hr/&gt;id: string pk&lt;br/&gt;classificationId: string fk&lt;br/&gt;chartType: string&lt;br/&gt;verdictText: string&lt;br/&gt;gaugeScore: number&lt;br/&gt;svgGraphic: object" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#0066cc;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="920" width="380" height="225" as="geometry" />
        </mxCell>

        <!-- Connection 1 -->
        <mxCell id="edge1" value="1 : *" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;" edge="1" parent="1" source="obj_parses" target="obj_perp">
          <mxGeometry relative="1" as="geometry" />
