        <!-- Connection 2 -->
        <mxCell id="edge2" value="1 : *" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;" edge="1" parent="1" source="obj_parses" target="obj_vec">
